# ============================================================
# PolicyLens RAG Engine — Environment Variables Template
# Copy to .env and fill in real values.
# NEVER commit .env — it is gitignored.
# ============================================================

# ── LlamaParse — PDF Parser (OPTIONAL) ────────────────────────
# Only needed if USE_LLAMAPARSE=true. PyMuPDF is the default parser.
# Sign up free at: https://cloud.llamaindex.ai
# Dashboard → API Keys → Create new key
# LLAMA_CLOUD_API_KEY=llx-your-key-here

# ── Google Gemini — LLM (Fallback) ──────────────────────────
# Get a FREE API key at: https://aistudio.google.com/apikeys
# Model: gemini-3-flash-preview (free, fast, high quality)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3-flash-preview

# ── Groq — Fast Inference LLM (REQUIRED) ──────────────────────────
# Get an API key at: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b

# ── (Legacy) Moonshot AI / Kimi — no longer required ────────
# These are kept for backward compatibility but are NOT needed.
# MOONSHOT_API_KEY=sk-your-moonshot-key-here
# KIMI_BASE_URL=https://api.moonshot.ai/v1
# KIMI_MODEL=moonshot-v1-8k

# ── Supabase — Database + Vector Store (REQUIRED) ──────────────
# Sign up free at: https://supabase.com
# Dashboard → Project Settings → API
# !! Use the service_role secret key — NOT the anon/public key !!
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
VECTOR_TABLE_NAME=policy_chunks

# ── Jina AI — Embeddings (REQUIRED for default setup) ──────────
# Sign up free at: https://jina.ai → Get API Key (free tier = 1M tokens/mo)
JINA_API_KEY=jina_your-key-here
EMBEDDING_PROVIDER=jina
EMBEDDING_MODEL=jina-embeddings-v3
EMBEDDING_DIMENSION=768

# ── Reranker ─────────────────────────────────────────────────────
# jina          = hosted API, uses JINA_API_KEY (default; no torch, small image)
# cross_encoder = local model; needs `pip install -r requirements-local.txt`
# none          = skip reranking (vector order)
RERANKER_PROVIDER=jina
RERANKER_MODEL=jina-reranker-v2-base-multilingual
COHERE_API_KEY=your-cohere-key-here

# ── Optional: OpenAI (only if EMBEDDING_PROVIDER=openai) ──────────
OPENAI_API_KEY=sk-your-key-here

# ── Debug ──────────────────────────────────────────────────────
DEBUG=false

# ── CORS Origins (RECOMMENDED IN PRODUCTION) ───────────────
# Comma-separated list. Use * only for temporary/dev usage.
# Example: https://policylens-ai.vercel.app,http://localhost:5173
CORS_ORIGINS=*

# ── Security ───────────────────────────────────────────────────
# Shared secret between the Node backend and this API. Set the SAME value in
# backend/.env. Generate: python -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_API_KEY=change-me

# Max PDF upload size in MB
MAX_UPLOAD_MB=25

# ── Scalability / resilience (all optional) ─────────────────────
# Shared cache for answers + query embeddings. Empty = per-process memory.
# Free tier: https://upstash.com  → Redis → copy the rediss:// URL
REDIS_URL=

# Run the PDF-ingest worker inside this process (true), or as a separate
# service: `python -m rag_engine.worker` (then set false here)
EMBEDDED_WORKER=true
WORKER_CONCURRENCY=1

# Max simultaneous LLM calls; extra requests wait up to LLM_QUEUE_TIMEOUT_SECONDS,
# then get a 503 + Retry-After instead of piling up
LLM_MAX_CONCURRENCY=6
LLM_QUEUE_TIMEOUT_SECONDS=20

# If the primary LLM errors, retry on this provider (needs its API key). e.g. gemini
LLM_FALLBACK_PROVIDER=

# Jina (embeddings + reranking) client-side throttle, calls/minute for this instance.
# Divide your Jina plan's limit by the number of instances. 0 disables.
JINA_MAX_RPM=80

# "Thinking" effort for gpt-oss models on Groq: low | medium | high.
# low = faster answers and fewer tokens against your Groq tokens-per-minute quota.
LLM_REASONING_EFFORT=low
